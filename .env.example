# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-secure-secret-key
PORT=5000
HOST=0.0.0.0

# Database Configuration
DB_HOST=replace-with-db-host
DB_PORT=5432
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_SCHEMA=hubspot

# DLT Configuration
DLT_PIPELINE_NAME=hubspot_deals_etl
DLT_WORKING_DIR=.dlt

# HubSpot API Configuration
HUBSPOT_PRIVATE_APP_ACCESS_TOKEN=replace-with-your-private-app-token
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
HUBSPOT_API_RATE_LIMIT=100

# Service Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7
REQUEST_TIMEOUT=30
PAGINATION_DEFAULT_LIMIT=50

# Logging Configuration
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=

# Optional: Production overrides
# SECRET_KEY=replace-with-production-secret-key
# DB_PASSWORD=replace-with-production-db-password
# FLASK_ENV=production
# FLASK_DEBUG=false